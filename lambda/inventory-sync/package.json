{
  "name": "shopify-inventory-sync",
  "version": "1.0.0",
  "description": "Lambda function for syncing inventory across multiple channels",
  "main": "handler.js",
  "dependencies": {
    "pg": "^8.11.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
